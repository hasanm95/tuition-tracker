# Copy this file to .env.local and fill in the values.

# --- Backend (Google Apps Script) ---
# The Apps Script web app /exec URL (from Deploy -> Manage deployments).
APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXX/exec
# A long random string. Must EXACTLY match API_TOKEN inside Code.gs.
# Generate one with: openssl rand -hex 24
APPS_SCRIPT_TOKEN=change-me-to-a-long-random-string

# --- Auth (NextAuth + Google sign-in) ---
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID (Web).
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxx
# Random secret for signing session tokens. Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-to-another-long-random-string
# Base URL of the app. Local: http://localhost:3000 . On Vercel: your deployment URL.
NEXTAUTH_URL=http://localhost:3000
# Comma-separated list of Google emails allowed to sign in (no spaces needed).
ALLOWED_EMAILS=tutor@gmail.com,you@gmail.com
